# Copy this file to .env for local runs (never commit the real .env).
# In GitHub Actions, set each of these as a repository secret instead.

# --- Garmin Connect (personal account credentials) ---
GARMIN_USERNAME=you@example.com
GARMIN_PASSWORD=your-garmin-password

# --- Location (used for Open-Meteo weather + air quality) ---
LOCATION_LATITUDE=38.7223
LOCATION_LONGITUDE=-9.1393
LOCATION_TIMEZONE=auto

# --- Email delivery (Gmail SMTP with an App Password recommended) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
SMTP_USE_TLS=true

# --- Storage ---
DB_PATH=data/advisor.db

# --- Thresholds (all optional; sensible defaults are used if omitted) ---
THRESHOLD_INACTIVITY_DAYS=3
THRESHOLD_OUTDOOR_TEMP_MIN_C=10
THRESHOLD_OUTDOOR_TEMP_MAX_C=27
THRESHOLD_OUTDOOR_PRECIP_PROB_MAX=30
THRESHOLD_OUTDOOR_WIND_MAX_KMH=25
THRESHOLD_FORECAST_WINDOW_HOURS=48
THRESHOLD_AQI_GOOD_MAX=50
THRESHOLD_AQI_MODERATE_MAX=100
